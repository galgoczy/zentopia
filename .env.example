# Resend — for outgoing email (team notification + visitor confirmation).
# Sign up at https://resend.com, verify the zentopia.io domain, and create an API key.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx

# Optional overrides — defaults are team@zentopia.io for both.
# CONTACT_TO=team@zentopia.io
# CONTACT_FROM=Zentopia <team@zentopia.io>

# Telegram bot — for instant push to your phone on new contact form submits.
# Create a bot with @BotFather, paste the token below.
TELEGRAM_BOT_TOKEN=12345:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TELEGRAM_CHAT_ID defaults to 5275561903.
# TELEGRAM_CHAT_ID=5275561903
